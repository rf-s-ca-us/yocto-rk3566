#!/bin/sh
# RAUC bundle 钩子。跑在「正在安装的那套系统」上,由 bundle 自带,
# 所以从还没有 bind 的旧镜像升级时也能执行。
# 只把允许名单从当前根文件系统拷进新槽,不格式化 data,不碰其它路径。
# 新槽开机后的 mount-persistent 再把这份拷贝收进 data 分区。
# 源路径如果已经是挂载点,说明内容在 data 上,这里不重复拷(避免每轮
# 升级都把 Hermes 状态再写进新槽)。
set -eu

. "$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)/persistent-common.sh"

case "${1:-}" in
	slot-post-install)
		persist_hook_slot_post_install
		;;
	*)
		echo "rauc-slot-hook: 未处理的参数 ${1:-}" >&2
		exit 1
		;;
esac
