#!/bin/sh
# 只在分区名恰好是 data、且即将写入的范围能被证明是空白时创建 ext4。
#
# blkid -p 不加 -D 时,空分区也会退出 0:它打印的是内核给的分区表项
# (PART_ENTRY_NAME / PART_ENTRY_UUID),不是文件系统。TYPE 是 blkid 根据
# 签名归出来的类,不是超级块里的字段;没有 TYPE、或者偏移 1080 的魔数为 0,
# 都不能当成「没有用户数据」。
#
# 允许写入的唯一情况:blkid -p -D 没有报错且没有识别出内容,并且将写入的
# 字节全是 0。末尾若是校验通过的标准备份 GPT(128 项),那段不写入,它前面
# 仍须全是 0。其它文件系统、加密、损坏、对不上的 GPT、I/O 错误都不格式化。
# mke2fs 不加强制开关,失败不重试。DATA_FORMAT_ALLOW_FILE 只给宿主机测试用。
#
# 板上的 /bin/sh 和 dd/od/awk 是 poky scarthgap 的 BusyBox 1.36.1。
# 这份 defconfig 没开 DESKTOP,也没开 FEATURE_DD_STATUS / FEATURE_DD_IBS_OBS:
# dd 只认识 if/of/bs/count/skip/seek,多一个操作数就直接退出 1,一个字节都不拷。
# od 只有传统短选项,没有地址进制、输出类型、跳过和长度这些开关。
# awk 开了 libm,但 printf 的 %u 会把不小于 2^31 的数打成 2147483648。
set -eu

DEV=${DATA_DEV:-/dev/disk/by-partlabel/data}
MIN_BYTES=1048576
CHUNK=8388608

log() {
	echo "format-data: $*"
}

# 打印 file 中 [off, off+len) 的每个字节,十进制一行一个。失败返回非 0。
# 先用 dd 截出这段(只使用 if/of/bs/count/skip),再交给两边都有的 od -b -v。
# -b 的数据域是恰好 3 位八进制;地址是 7 位,不收。出现星号折叠说明没加 -v,拒绝。
od_bytes() {
	od_file=$1
	od_off=$2
	od_len=$3
	od_tmp=$(mktemp) || return 1
	if ! dd if="$od_file" of="$od_tmp" bs=1 skip="$od_off" count="$od_len" 2>/dev/null; then
		rm -f "$od_tmp"
		return 1
	fi
	od_got=$(wc -c < "$od_tmp" | tr -d ' ')
	if [ "$od_got" -ne "$od_len" ]; then
		rm -f "$od_tmp"
		return 1
	fi
	od_rc=0
	od -b -v "$od_tmp" | awk -v expect="$od_len" '
		function oct(s,    v, k) {
			v = 0
			for (k = 1; k <= length(s); k++)
				v = v * 8 + index("01234567", substr(s, k, 1)) - 1
			return v
		}
		{
			for (i = 1; i <= NF; i++) {
				if ($i == "*")
					bad = 1
				else if ($i ~ /^[0-7][0-7][0-7]$/) {
					print oct($i)
					n++
				}
			}
		}
		END {
			if (bad || n != expect)
				exit 2
		}
	' || od_rc=$?
	rm -f "$od_tmp"
	return "$od_rc"
}

read_le32() {
	vals=$(od_bytes "$1" "$2" 4) || return 1
	# shellcheck disable=SC2086
	set -- $vals
	[ $# -eq 4 ] || return 1
	echo $(($1 + $2 * 256 + $3 * 65536 + $4 * 16777216))
}

crc32_92() {
	od_bytes "$1" 0 92 | awk '
		function bxor(a, b,    i, r, xa, xb) {
			r = 0
			for (i = 0; i < 32; i++) {
				xa = a % 2
				xb = b % 2
				if (xa != xb) r += 2 ^ i
				a = int(a / 2)
				b = int(b / 2)
			}
			return r
		}
		NF == 0 { next }
		{
			byte[++n] = $1 + 0
		}
		END {
			if (n != 92) exit 2
			byte[17] = 0
			byte[18] = 0
			byte[19] = 0
			byte[20] = 0
			crc = 4294967295
			for (i = 1; i <= 92; i++) {
				crc = bxor(crc, byte[i])
				for (k = 0; k < 8; k++) {
					if (crc % 2) crc = bxor(int(crc / 2), 3988292384)
					else crc = int(crc / 2)
				}
			}
			printf "%.0f\n", bxor(crc, 4294967295)
		}
	'
}

# 0: 打印可写入的字节数。1: 末尾像 GPT 但校验不过,调用方不得格式化。
writable_bytes() {
	dev=$1
	bytes=$2
	part_start=$3
	if [ $((bytes % 512)) -ne 0 ] || [ "$bytes" -lt 1024 ]; then
		return 1
	fi
	sectors=$((bytes / 512))
	hdr=$(mktemp)
	dd if="$dev" of="$hdr" bs=512 count=1 skip=$((sectors - 1)) 2>/dev/null || {
		rm -f "$hdr"
		return 1
	}
	sig=$(dd if="$hdr" bs=8 count=1 2>/dev/null) || {
		rm -f "$hdr"
		return 1
	}
	if [ "$sig" != "EFI PART" ]; then
		rm -f "$hdr"
		echo "$bytes"
		return 0
	fi
	rev=$(read_le32 "$hdr" 8) || { rm -f "$hdr"; return 1; }
	hsz=$(read_le32 "$hdr" 12) || { rm -f "$hdr"; return 1; }
	stored=$(read_le32 "$hdr" 16) || { rm -f "$hdr"; return 1; }
	calc=$(crc32_92 "$hdr") || { rm -f "$hdr"; return 1; }
	my_hi=$(read_le32 "$hdr" 28) || { rm -f "$hdr"; return 1; }
	my_lo=$(read_le32 "$hdr" 24) || { rm -f "$hdr"; return 1; }
	ent_hi=$(read_le32 "$hdr" 76) || { rm -f "$hdr"; return 1; }
	ent_lo=$(read_le32 "$hdr" 72) || { rm -f "$hdr"; return 1; }
	nent=$(read_le32 "$hdr" 80) || { rm -f "$hdr"; return 1; }
	esz=$(read_le32 "$hdr" 84) || { rm -f "$hdr"; return 1; }
	rm -f "$hdr"
	if [ "$rev" != 65536 ] || [ "$hsz" != 92 ] || [ "$stored" != "$calc" ]; then
		return 1
	fi
	if [ "$my_hi" != 0 ] || [ "$ent_hi" != 0 ] || [ "$esz" != 128 ] || [ "$nent" != 128 ]; then
		return 1
	fi
	expect=$((part_start + sectors - 1))
	if [ "$my_lo" != "$expect" ] || [ "$ent_lo" -lt "$part_start" ]; then
		return 1
	fi
	rel=$((ent_lo - part_start))
	array_off=$((rel * 512))
	array_len=$((nent * esz))
	if [ "$array_off" -lt $((bytes - MIN_BYTES)) ]; then
		return 1
	fi
	if [ $((array_off + array_len)) -gt $((bytes - 512)) ]; then
		return 1
	fi
	echo "$array_off"
	return 0
}

range_is_zero() {
	dev=$1
	bytes=$2
	off=0
	tmp=$(mktemp)
	while [ "$off" -lt "$bytes" ]; do
		n=$CHUNK
		if [ $((off + n)) -gt "$bytes" ]; then
			n=$((bytes - off))
		fi
		if [ $((off % 4096)) -eq 0 ] && [ $((n % 4096)) -eq 0 ]; then
			dd if="$dev" of="$tmp" bs=4096 skip=$((off / 4096)) count=$((n / 4096)) 2>/dev/null || {
				rm -f "$tmp"
				return 2
			}
		else
			dd if="$dev" of="$tmp" bs=1 skip="$off" count="$n" 2>/dev/null || {
				rm -f "$tmp"
				return 2
			}
		fi
		got=$(wc -c < "$tmp" | tr -d ' ')
		if [ "$got" -ne "$n" ]; then
			rm -f "$tmp"
			return 2
		fi
		if tr -d '\000' < "$tmp" | grep -q .; then
			rm -f "$tmp"
			return 1
		fi
		off=$((off + n))
	done
	rm -f "$tmp"
	return 0
}

part_base() {
	basename "$(readlink -f "$1")"
}

# 内核 uevent 的 PARTNAME 和 blkid 的 PART_ENTRY_NAME 是同一条 GPT 分区名。
# loop 上有的内核只给后者。两者都空才算没有名字。
part_name() {
	base=$1
	dev=$2
	name=$(awk -F= '$1 == "PARTNAME" { print $2; exit }' "/sys/class/block/$base/uevent" 2>/dev/null || true)
	if [ -n "$name" ]; then
		printf '%s\n' "$name"
		return 0
	fi
	blkid -p -s PART_ENTRY_NAME -o value "$dev" 2>/dev/null || true
}

device_in_use() {
	base=$1
	canon=$(readlink -f "$DEV")
	if [ -d "/sys/class/block/$base/holders" ] && [ -n "$(ls -A "/sys/class/block/$base/holders" 2>/dev/null)" ]; then
		log "$DEV 仍被占用,拒绝格式化"
		return 0
	fi
	hit=$(awk '$1 ~ /^\// { print $1 }' /proc/mounts | while read -r src; do
		if [ -e "$src" ] && [ "$(readlink -f "$src" 2>/dev/null || true)" = "$canon" ]; then
			echo yes
			break
		fi
	done)
	if [ -n "$hit" ]; then
		log "$DEV 已挂载,拒绝格式化"
		return 0
	fi
	root=$(awk '$2 == "/" { print $1; exit }' /proc/mounts)
	if [ -n "$root" ] && [ -e "$root" ] && [ "$(readlink -f "$root" 2>/dev/null || true)" = "$canon" ]; then
		log "$DEV 是根设备,拒绝格式化"
		return 0
	fi
	return 1
}

if [ ! -e "$DEV" ] && [ "$DEV" = /dev/disk/by-partlabel/data ]; then
	i=0
	while [ ! -e "$DEV" ]; do
		i=$((i + 1))
		if [ "$i" -ge 30 ]; then
			break
		fi
		sleep 1
	done
fi

if [ ! -e "$DEV" ]; then
	log "没有 $DEV,拒绝格式化"
	exit 1
fi

part_start=0
if [ -b "$DEV" ]; then
	base=$(part_base "$DEV")
	if [ ! -f "/sys/class/block/$base/partition" ]; then
		log "$DEV 不是分区,拒绝格式化"
		exit 1
	fi
	name=$(part_name "$base" "$DEV")
	if [ "$name" != data ]; then
		log "$DEV 的分区名是 ${name:-<空>},拒绝格式化"
		exit 1
	fi
	same=0
	for ev in /sys/class/block/*/partition; do
		[ -f "$ev" ] || continue
		other=$(basename "$(dirname "$ev")")
		n=$(part_name "$other" "/dev/$other")
		if [ "$n" = data ]; then
			same=$((same + 1))
		fi
	done
	if [ "$same" -ne 1 ]; then
		log "名为 data 的分区有 ${same} 个,拒绝格式化"
		exit 1
	fi
	start=$(cat "/sys/class/block/$base/start")
	secs=$(cat "/sys/class/block/$base/size")
	log "目标 $base 起点 ${start} 扇区,长度 ${secs} 扇区"
	part_start=$start
	if device_in_use "$base"; then
		exit 1
	fi
elif [ "${DATA_FORMAT_ALLOW_FILE:-}" != 1 ]; then
	log "$DEV 不是块设备,拒绝格式化"
	exit 1
else
	part_start=${DATA_PART_START:-0}
fi

if ! command -v blkid >/dev/null 2>&1; then
	log "没有 blkid,拒绝格式化"
	exit 1
fi

err=$(mktemp)
set +e
probe=$(blkid -p -D -o export "$DEV" 2>"$err")
rc=$?
set -e
if [ -s "$err" ]; then
	log "blkid -p -D $DEV 报错,拒绝格式化"
	cat "$err" >&2 || true
	rm -f "$err"
	exit 1
fi
rm -f "$err"

TYPE=$(printf '%s\n' "$probe" | awk -F= '$1 == "TYPE" { print substr($0, 6); exit }')
USAGE=$(printf '%s\n' "$probe" | awk -F= '$1 == "USAGE" { print substr($0, 7); exit }')
LABEL=$(printf '%s\n' "$probe" | awk -F= '$1 == "LABEL" { print substr($0, 7); exit }')
PTTYPE=$(printf '%s\n' "$probe" | awk -F= '$1 == "PTTYPE" { print substr($0, 8); exit }')

if [ "$rc" -eq 0 ] && [ "$TYPE" = ext4 ] && [ "$USAGE" = filesystem ] && [ "$LABEL" = data ]; then
	log "$DEV 已是 ext4 LABEL=data,不格式化"
	exit 0
fi
if [ "$rc" -eq 0 ]; then
	log "探测到 TYPE=${TYPE:-<空>} USAGE=${USAGE:-<空>} LABEL=${LABEL:-<空>} PTTYPE=${PTTYPE:-<空>},不格式化"
	exit 1
fi
if [ "$rc" -ne 2 ]; then
	log "blkid -p -D $DEV 退出 $rc,拒绝格式化"
	exit 1
fi

# 0x53 0xef。读不到就不能当成「没有魔数」。
magic_vals=$(od_bytes "$DEV" 1080 2) || {
	log "读不到 $DEV 偏移 1080 的超级块魔数,拒绝格式化"
	exit 1
}
# shellcheck disable=SC2086
set -- $magic_vals
if [ "$#" -ne 2 ]; then
	log "读不到 $DEV 偏移 1080 的超级块魔数,拒绝格式化"
	exit 1
fi
if [ "$1" -eq 83 ] && [ "$2" -eq 239 ]; then
	log "$DEV 有 ext 超级块魔数,不格式化"
	exit 1
fi

if [ -b "$DEV" ]; then
	if ! command -v blockdev >/dev/null 2>&1; then
		log "没有 blockdev,拒绝格式化"
		exit 1
	fi
	dev_bytes=$(blockdev --getsize64 "$DEV")
else
	dev_bytes=$(wc -c < "$DEV" | tr -d ' ')
fi

set +e
limit=$(writable_bytes "$DEV" "$dev_bytes" "$part_start")
wrc=$?
set -e
if [ "$wrc" -ne 0 ] || [ -z "$limit" ]; then
	log "$DEV 末尾的 GPT 校验不过,拒绝格式化"
	exit 1
fi
if [ "$limit" -lt "$MIN_BYTES" ]; then
	log "$DEV 可写入范围只有 ${limit} 字节,拒绝格式化"
	exit 1
fi

set +e
range_is_zero "$DEV" "$limit"
zrc=$?
set -e
if [ "$zrc" -eq 1 ]; then
	log "$DEV 可写入范围不是全零,拒绝格式化"
	exit 1
fi
if [ "$zrc" -ne 0 ]; then
	log "读取 $DEV 失败,拒绝格式化"
	exit 1
fi

if [ -b "$DEV" ] && device_in_use "$(part_base "$DEV")"; then
	exit 1
fi

if ! command -v mke2fs >/dev/null 2>&1; then
	log "没有 mke2fs,拒绝格式化"
	exit 1
fi

log "确认 $DEV 空白,创建 ext4 LABEL=data"
if [ "$limit" -eq "$dev_bytes" ]; then
	mke2fs -t ext4 -L data -E nodiscard "$DEV" </dev/null
else
	blocks=$((limit / 4096))
	# 缩小文件系统,末尾已校验的备份 GPT 不在写入范围内。
	mke2fs -t ext4 -b 4096 -L data -E nodiscard "$DEV" "$blocks" </dev/null
fi

if [ -b "$DEV" ] && command -v blockdev >/dev/null 2>&1; then
	blockdev --flushbufs "$DEV" || true
fi

label=$(blkid -p -D -s LABEL -o value "$DEV" 2>/dev/null || true)
if [ "$label" != data ]; then
	log "格式化后 LABEL=${label:-<空>},期望 data"
	exit 1
fi

if [ "$limit" -ne "$dev_bytes" ]; then
	# 只取签名 8 字节。整扇区里签名后面就是 0,放进 shell 变量会被截断或带上后续字节。
	sig=$(dd if="$DEV" bs=1 skip=$((dev_bytes - 512)) count=8 2>/dev/null || true)
	if [ "$sig" != "EFI PART" ]; then
		log "格式化改写了末尾的备份 GPT"
		exit 1
	fi
fi

if [ -b "$DEV" ] && command -v udevadm >/dev/null 2>&1; then
	udevadm trigger --action=change "$DEV" || log "udevadm trigger 失败"
	udevadm settle || true
fi

log "$DEV 已是 LABEL=data"
exit 0
