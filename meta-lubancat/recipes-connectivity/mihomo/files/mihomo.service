[Unit]
Description=mihomo 代理(hermes 出站依赖 127.0.0.1:7890)
# 不挂 network-online:它由 networkd-wait-online 守着,本板每轮 boot 都要等满
# 2 分钟超时(2026-09-19 实机),而本服务只需本机接口——mihomo 只绑 127.0.0.1,
# gateway 自带断线重连。network.target(本机接口就位)足够。
After=network.target
# 配置运行时人工放:没有 config.yaml 时直接跳过而不是起来报错刷日志
ConditionPathExists=/etc/mihomo/config.yaml

[Service]
Type=simple
ExecStart=/usr/bin/mihomo -d /etc/mihomo
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
